@app.get("/api/drive_movies")
def drive_movies():
    if not os.path.isdir(SRC_DIR):
        return {"mounted": False, "files": []}
    out = []
    for f in sorted(os.listdir(SRC_DIR)):
        if f.lower().endswith(VIDEO_EXT):
            stem = os.path.splitext(f)[0]
            o = f"{stem}_km.mp4"
            out.append({"name": f, "mb": round(os.path.getsize(f"{SRC_DIR}/{f}") / 1e6),
                        "done": os.path.exists(f"{OUT_DIR}/{o}"), "out": o})
    return {"mounted": True, "files": out}


@app.post("/api/batch_start")
async def batch_start(files_json: str = Form(...), lang: str = Form("auto"), gender: str = Form("female"),
                      detect: int = Form(1), speech_rate: int = Form(15), khmer_volume: float = Form(3.0),
                      original_volume: float = Form(0.15)):
    if BATCH["running"]:
        raise HTTPException(400, "Batch កំពុងដំណើរការ")
    if not os.path.isdir(SRC_DIR):
        raise HTTPException(400, "Drive មិនទាន់ mount ឬគ្មានថត movies (run Cell 3)")
    files = [f for f in json.loads(files_json) if os.path.isfile(f"{SRC_DIR}/{os.path.basename(f)}")]
    files = [os.path.basename(f) for f in files]
    if not files:
        raise HTTPException(400, "មិនបានជ្រើសភាពយន្ត")
    cfg = {"lang": lang if lang in ("auto", "en", "zh") else "auto",
           "gender": gender if gender in VOICES else "female", "detect": bool(detect),
           "rate": max(0, min(50, speech_rate)), "kvol": max(1.0, min(6.0, khmer_volume)),
           "orig": max(0.0, min(1.0, original_volume))}
    BATCH["log"] = []
    threading.Thread(target=batch_worker, args=(files, cfg), daemon=True).start()
    return {"started": len(files)}


