# ===================== BATCH (many movies from Drive) =====================
BATCH = {"running": False, "stop": False, "total": 0, "index": 0, "current": "", "stage": "",
         "progress": 0, "ok": [], "failed": {}, "log": []}


class Stopped(Exception):
    pass


def blog(msg):
    BATCH["log"].append(time.strftime("%H:%M:%S ") + msg)
    del BATCH["log"][:-150]


def bstage(stage, p=0):
    BATCH["stage"], BATCH["progress"] = stage, round(p, 1)
    blog(f"[{BATCH['current']}] {stage}")


def bcheck():
    if BATCH["stop"]:
        raise Stopped()


def srt_write(path, segs, texts):
    out = [f"{i}\n{fmt(s['start'])} --> {fmt(s['end'])}\n{t}\n"
           for i, (s, t) in enumerate(zip(segs, texts), 1)]
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(out))


def srt_read(path):
    txt = open(path, encoding="utf-8-sig").read().replace("\r", "").strip()
    segs, texts = [], []
    for b in re.split(r"\n{2,}", txt):
        lines = b.split("\n")
        k = next((i for i, l in enumerate(lines) if "-->" in l), None)
        if k is None:
            continue
        a, c = lines[k].split("-->")
        segs.append({"start": sec(a), "end": sec(c)})
        texts.append(" ".join(lines[k + 1:]).strip())
    return segs, texts


def process_movie(fname, cfg):
    stem = os.path.splitext(fname)[0]
    final = f"{OUT_DIR}/{stem}_km.mp4"
    src_srt, km_srt, gj = (f"{OUT_DIR}/{stem}.src.srt", f"{OUT_DIR}/{stem}.km.srt",
                           f"{OUT_DIR}/{stem}.gender.json")
    local, wav = f"{TMP}/{fname}", f"{TMP}/{stem}.16k.wav"
    try:
        bstage("ចម្លងពី Drive")
        shutil.copy(f"{SRC_DIR}/{fname}", local)
        bcheck()
        bstage("ទាញសំឡេង")
        make_wav(local, wav)
        bcheck()

        # 1. transcript
        if os.path.exists(src_srt):
            segs, src_txt = srt_read(src_srt)
            blog(f"[{stem}] transcript loaded ({len(segs)})")
        else:
            bstage("Whisper")
            audio = load_audio(local, wav)
            res = whisper_run(audio, cfg["lang"],
                              lambda p, n: BATCH.update(progress=round(p, 1), stage=f"Whisper {n} ឃ្លា"))
            del audio
            gc.collect()
            segs = [{"start": s["start"], "end": s["end"]} for s in res]
            src_txt = [s["text"] for s in res]
            srt_write(src_srt, segs, src_txt)
        bcheck()

        # 2. translation
        km = None
        if os.path.exists(km_srt):
            _, km = srt_read(km_srt)
            if len(km) != len(segs):
                km = None
        if km is None:
            bstage("បកប្រែខ្មែរ")
            km = translate_texts(src_txt, lambda d, t: BATCH.update(
                progress=round(d / t * 100, 1), stage=f"បកប្រែ {d}/{t}"))
            srt_write(km_srt, segs, km)
        bcheck()

        # 3. gender
        genders = []
        if cfg["detect"]:
            if os.path.exists(gj):
                genders = json.load(open(gj))
            else:
                bstage("រកប្រុស/ស្រី")
                audio = load_audio(local, wav)
                genders = detect_genders(audio, [(s["start"], s["end"]) for s in segs],
                                         lambda p: BATCH.update(progress=round(p, 1)))
                del audio
                gc.collect()
                json.dump(genders, open(gj, "w"))
        bcheck()

        # 4. dubbing
        bstage("Dubbing")
        items = []
        for i, (s, t) in enumerate(zip(segs, km)):
            t = re.sub(r"\s+", " ", t).strip()
            if not t or t == ".":
                continue
            g = genders[i] if i < len(genders) and genders[i] else cfg["gender"]
            items.append({"start": s["start"], "end": s["end"], "text": t, "voice": VOICES[g]})
        out = dub_core(local, items, f"{TMP}/{stem}_km", cfg["orig"], cfg["rate"], cfg["kvol"],
                       lambda p, m: BATCH.update(progress=round(p, 1), stage=m))
        bcheck()
        bstage("ដាក់ចូល Drive", 95)
        shutil.copy(out, final + ".part")
        os.replace(final + ".part", final)
        os.remove(out)
        blog(f"[{stem}] DONE -> {final}")
    finally:
        for p in (local, wav, f"{TMP}/{stem}_km.mp4"):
            if os.path.exists(p):
                os.remove(p)
        gc.collect()


def batch_worker(files, cfg):
    os.makedirs(OUT_DIR, exist_ok=True)
    BATCH.update(running=True, stop=False, total=len(files), index=0, ok=[], failed={})
    try:
        for n, f in enumerate(files, 1):
            if BATCH["stop"]:
                break
            BATCH.update(index=n, current=f, progress=0, stage="")
            stem = os.path.splitext(f)[0]
            if os.path.exists(f"{OUT_DIR}/{stem}_km.mp4"):
                blog(f"[{f}] រួចហើយ រំលង")
                BATCH["ok"].append(f)
                continue
            try:
                process_movie(f, cfg)
                BATCH["ok"].append(f)
            except Stopped:
                blog(f"[{f}] បានបញ្ឈប់")
                break
            except Exception as e:
                BATCH["failed"][f] = str(e)[:300]
                blog(f"[{f}] ERROR: {e}")
                traceback.print_exc()
