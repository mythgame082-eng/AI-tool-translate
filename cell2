# ---------- upload ----------
@app.post("/api/upload")
async def upload(file: UploadFile = File(...)):
    ext = os.path.splitext(file.filename or "")[1] or ".mp4"
    name = f"work/up_{uuid.uuid4().hex[:8]}{ext}"
    with open(f"{ROOT}/{name}", "wb") as o:
        while True:
            chunk = await file.read(8 * 1024 * 1024)
            if not chunk:
                break
            o.write(chunk)
    return {"video": name}


def _safe_id(s):
    return re.sub(r"[^a-zA-Z0-9]", "", s)[:40] or "x"


@app.post("/api/upload_chunk")
async def upload_chunk(file: UploadFile = File(...), upload_id: str = Form(...), index: int = Form(...)):
    d = f"{WORK}/chunks_{_safe_id(upload_id)}"
    os.makedirs(d, exist_ok=True)
    with open(f"{d}/{int(index):05d}.part", "wb") as o:
        while True:
            chunk = await file.read(8 * 1024 * 1024)
            if not chunk:
                break
            o.write(chunk)
    return {"ok": True}


@app.post("/api/upload_done")
async def upload_done(upload_id: str = Form(...), total: int = Form(...), ext: str = Form(".mp4")):
    d = f"{WORK}/chunks_{_safe_id(upload_id)}"
    ext = ext if re.fullmatch(r"\.[a-zA-Z0-9]{1,5}", ext or "") else ".mp4"
    name = f"work/up_{uuid.uuid4().hex[:8]}{ext}"
    with open(f"{ROOT}/{name}", "wb") as o:
        for i in range(int(total)):
            part = f"{d}/{i:05d}.part"
            if not os.path.exists(part):
                raise HTTPException(400, f"missing chunk {i}")
            with open(part, "rb") as p:
                shutil.copyfileobj(p, o, 8 * 1024 * 1024)
    shutil.rmtree(d, ignore_errors=True)
    return {"video": name}


# ---------- audio + Whisper (low RAM, no PyAV) ----------
_model = None  # (model, "cuda"/"cpu")


def prepare_cuda():
    import ctypes, site
    roots = list(site.getsitepackages()) + [site.getusersitepackages()]
    for sub in ("cuda_runtime", "cublas", "cudnn"):
        for r in roots:
            for f in sorted(glob.glob(f"{r}/nvidia/{sub}/lib/*.so*")):
                try:
                    ctypes.CDLL(f, mode=ctypes.RTLD_GLOBAL)
                except OSError:
                    pass


def get_model(cpu=False):
    global _model
    if _model is None or (cpu and _model[1] != "cpu"):
        prepare_cuda()
        from faster_whisper import WhisperModel
        gpu = False
        if not cpu:
            try:
                import torch
                gpu = torch.cuda.is_available()
            except Exception:
                gpu = False
        if gpu:
            _model = (WhisperModel("large-v3", device="cuda", compute_type="int8_float16"), "cuda")
        else:
            _model = (WhisperModel("small", device="cpu", compute_type="int8"), "cpu")
    return _model[0]


def ff(*args):
    subprocess.run(["ffmpeg", "-y", "-v", "error", *args], check=True)


def make_wav(video, wav):
    if not os.path.exists(wav) or os.path.getsize(wav) == 0:
        ff("-i", video, "-vn", "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", wav)


def load_audio(path, wav=None):
    wav = wav or f"{WORK}/{re.sub(r'[^A-Za-z0-9]', '_', path)[-80:]}.16k.wav"
    make_wav(path, wav)
    with wave.open(wav, "rb") as w:
        raw = w.readframes(w.getnframes())
    return np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0


def whisper_run(audio, lang, cb=None):
    def go(model):
        segs, info = model.transcribe(audio, language=(None if lang in ("", "auto") else lang),
                                      vad_filter=True)
        total = max(info.duration, 1)
        out = []
        for s in segs:
            t = s.text.strip()
            if not t:
                continue
            out.append({"start": round(s.start, 3), "end": round(s.end, 3), "text": t})
            if cb:
                cb(min(99, s.end / total * 100), len(out))
        return out
    try:
        return go(get_model())
    except Exception as e:
        if not re.search(r"cublas|cudnn|libcu|cuda", str(e), re.I):
            raise
        return go(get_model(cpu=True))


def do_transcribe(jid, path, lang):
    prog(jid, 1, "Extracting audio...")
    audio = load_audio(path)
    prog(jid, 2, "Loading Whisper...")
    try:
        segs = whisper_run(audio, lang, lambda p, n: prog(jid, p, f"{n} lines"))
    finally:
        del audio
        gc.collect()
    return [{"id": i + 1, "start": s["start"], "end": s["end"],
             "time": f"{fmt(s['start'])} - {fmt(s['end'])}", "chinese": s["text"], "khmer": ""}
            for i, s in enumerate(segs)]


@app.post("/api/transcribe")
async def transcribe(video: str = Form(...), language: str = Form("auto")):
    return run_job(do_transcribe, resolve(video), language)


# ---------- male / female (pitch) ----------
def _f0(x, sr=16000):
    fl, hop = int(0.04 * sr), int(0.02 * sr)
    lo, hi = int(sr / 400), int(sr / 70)
    n = 1 << (2 * fl - 1).bit_length()
    vals = []
    for s in range(0, len(x) - fl, hop):
        f = x[s:s + fl].astype(np.float64)
        f = f - f.mean()
        if np.sqrt((f ** 2).mean()) < 0.01:
            continue
        sp = np.fft.rfft(f, n)
        ac = np.fft.irfft(sp * np.conj(sp))[:hi + 1]
        if ac[0] <= 0:
            continue
        k = lo + int(np.argmax(ac[lo:hi + 1]))
        if ac[k] / ac[0] > 0.4:
            vals.append(sr / k)
    return float(np.median(vals)) if len(vals) >= 3 else None


def detect_genders(audio, segs, cb=None):
    sr, out = 16000, []
    for i, (a, b) in enumerate(segs):
        a, b = int(float(a) * sr), int(float(b) * sr)
        b = min(b, a + 4 * sr)
        f0 = _f0(audio[a:b]) if b > a else None
        out.append("" if f0 is None else ("male" if f0 < 165 else "female"))
        if cb and i % 20 == 0:
            cb(i / max(1, len(segs)) * 100)
    return out


def do_detect(jid, path, segs):
    prog(jid, 1, "Loading audio...")
    audio = load_audio(path)
    try:
        return detect_genders(audio, segs, lambda p: prog(jid, p, f"{int(p)}%"))
    finally:
        del audio
        gc.collect()


@app.post("/api/detect_gender")
