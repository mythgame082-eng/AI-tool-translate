# ===================== BATCH: many movies -> Khmer dub, fully automatic =====================
import os, re, json, wave, glob, shutil, subprocess, threading, time, asyncio, gc, traceback
import numpy as np, requests, edge_tts
from google.colab import drive
drive.mount('/content/drive')

# ---------------- CONFIG ----------------
SRC_DIR = '/content/drive/MyDrive/movies'        # input movies folder in Drive
OUT_DIR = '/content/drive/MyDrive/movies_done'   # results folder (auto-created)
LANG = 'auto'          # 'auto', 'en' or 'zh'
DEFAULT_VOICE = 'female'   # 'female' (Sreymom) or 'male' (Piseth)
DETECT_GENDER = True   # pick male/female voice per line from the original audio (approximate)
SPEECH_RATE = 15       # Khmer speech speed, +% (0..50)
KHMER_VOL = 3.0        # Khmer voice volume (3.0 = 300%)
ORIG_VOL = 0.15        # original sound volume (0..1)
ONLY = []              # e.g. ['m01.mp4','m02.mp4']; empty = all movies
# ----------------------------------------

TMP = '/content/batch_tmp'
RATE = 24000
VOICES = {"male": "km-KH-PisethNeural", "female": "km-KH-SreymomNeural"}
os.makedirs(OUT_DIR, exist_ok=True)
os.makedirs(TMP, exist_ok=True)


def log(stem, msg):
    print(f"[{stem}] {msg}", flush=True)


def fmt(t):
    ms = int(round(t * 1000))
    h, ms = divmod(ms, 3600000)
    m, ms = divmod(ms, 60000)
    s, ms = divmod(ms, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


def sec(t):
    m = re.match(r"\s*(\d+):(\d+):(\d+)[,.](\d+)", t)
    return int(m[1]) * 3600 + int(m[2]) * 60 + int(m[3]) + float("0." + m[4]) if m else 0.0


def srt_write(path, segs, texts):
    out = []
    for i, (s, t) in enumerate(zip(segs, texts), 1):
        out.append(f"{i}\n{fmt(s['start'])} --> {fmt(s['end'])}\n{t}\n")
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(out))


def srt_read(path):
    txt = open(path, encoding="utf-8-sig").read().replace("\r", "").strip()
    segs, texts = [], []
    for b in re.split(r"\n{2,}", txt):
        lines = b.split("\n")
        k = next((i for i, l in enumerate(lines) if "-->" in l), None)
        if k is None:
            continue
        a, c = lines[k].split("-->")
        segs.append({"start": sec(a), "end": sec(c)})
        texts.append(" ".join(lines[k + 1:]).strip())
    return segs, texts


def ff(*args):
    subprocess.run(["ffmpeg", "-y", "-v", "error", *args], check=True)


def run_async(coro):
    # Colab already runs an event loop, so run asyncio in a separate thread
    err = []

    def w():
        try:
            asyncio.run(coro)
        except Exception as e:
            err.append(e)

    t = threading.Thread(target=w)
    t.start()
    t.join()
    if err:
        raise err[0]


# ---------------- audio ----------------
def make_wav(video, wav):
    if not os.path.exists(wav):
        ff("-i", video, "-vn", "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", wav)


def load_wav(wav):
    with wave.open(wav, "rb") as w:
        raw = w.readframes(w.getnframes())
    return np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0


# ---------------- Whisper ----------------
_model = None


def prepare_cuda():
    import ctypes, site
    roots = list(site.getsitepackages()) + [site.getusersitepackages()]
    for sub in ("cuda_runtime", "cublas", "cudnn"):
        for r in roots:
            for f in sorted(glob.glob(f"{r}/nvidia/{sub}/lib/*.so*")):
                try:
                    ctypes.CDLL(f, mode=ctypes.RTLD_GLOBAL)
                except OSError:
                    pass


def get_model(cpu=False):
    global _model
    if _model is None or (cpu and _model[1] != "cpu"):
        prepare_cuda()
        from faster_whisper import WhisperModel
        gpu = False
        if not cpu:
            try:
                import torch
                gpu = torch.cuda.is_available()
            except Exception:
                gpu = False
        if gpu:
            _model = (WhisperModel("large-v3", device="cuda", compute_type="int8_float16"), "cuda")
        else:
            _model = (WhisperModel("small", device="cpu", compute_type="int8"), "cpu")
    return _model[0]


def whisper_segments(audio, stem):
    def go(model):
        segs, info = model.transcribe(audio, language=(None if LANG in ("", "auto") else LANG),
                                      vad_filter=True)
        total = max(info.duration, 1)
        out, last = [], 0
        for s in segs:
            t = s.text.strip()
            if not t:
                continue
            out.append({"start": round(s.start, 3), "end": round(s.end, 3), "text": t})
            if s.end - last > 300:
                last = s.end
                log(stem, f"Whisper {int(s.end / total * 100)}% ({len(out)} lines)")
        return out
    try:
        return go(get_model())
    except Exception as e:
        if not re.search(r"cublas|cudnn|libcu|cuda", str(e), re.I):
            raise
        log(stem, "GPU problem -> CPU (slower)")
        return go(get_model(cpu=True))


# ---------------- translation ----------------
def _tr_edge(texts, token):
    r = requests.post("https://api-edge.cognitive.microsofttranslator.com/translate",
                      params={"to": "km", "api-version": "3.0"},
                      headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
                      json=[{"Text": t} for t in texts], timeout=60)
    r.raise_for_status()
    return [x["translations"][0]["text"] for x in r.json()]


def _tr_google(texts):
    out = []
    for t in texts:
        r = requests.get("https://translate.googleapis.com/translate_a/single",
                         params={"client": "gtx", "sl": "auto", "tl": "km", "dt": "t", "q": t}, timeout=20)
        r.raise_for_status()
        out.append("".join(p[0] for p in r.json()[0] if p[0]))
        time.sleep(0.3)
    return out


def translate_all(texts, stem):
    texts = [re.sub(r"\s+", " ", t).strip() or "." for t in texts]
    out, B, token, last_err = [], 40, None, ""
    for i in range(0, len(texts), B):
        part, res = texts[i:i + B], None
        for attempt in range(3):
            try:
                if token is None:
                    token = requests.get("https://edge.microsoft.com/translate/auth", timeout=20).text
                res = _tr_edge(part, token)
                break
            except Exception as e:
                last_err, token = "Edge: " + str(e), None
                time.sleep(2 * (attempt + 1))
        if res is None:
            try:
                res = _tr_google(part)
            except Exception as e:
                raise RuntimeError("Translate failed. " + last_err + " | Google: " + str(e))
        out += res
        if (i // B) % 10 == 0:
            log(stem, f"translate {len(out)}/{len(texts)}")
    return out


# ---------------- male / female (pitch) ----------------
def _f0(x, sr=16000):
    fl, hop = int(0.04 * sr), int(0.02 * sr)
    lo, hi = int(sr / 400), int(sr / 70)
    n = 1 << (2 * fl - 1).bit_length()
    vals = []
    for s in range(0, len(x) - fl, hop):
        f = x[s:s + fl].astype(np.float64)
        f = f - f.mean()
        if np.sqrt((f ** 2).mean()) < 0.01:
            continue
        sp = np.fft.rfft(f, n)
        ac = np.fft.irfft(sp * np.conj(sp))[:hi + 1]
        if ac[0] <= 0:
            continue
        k = lo + int(np.argmax(ac[lo:hi + 1]))
        if ac[k] / ac[0] > 0.4:
            vals.append(sr / k)
    return float(np.median(vals)) if len(vals) >= 3 else None


def detect_genders(audio, segs):
    sr, out = 16000, []
    for s in segs:
        a = int(s["start"] * sr)
        b = min(int(s["end"] * sr), a + 4 * sr)
        f0 = _f0(audio[a:b]) if b > a else None
        out.append("" if f0 is None else ("male" if f0 < 165 else "female"))
    return out


# ---------------- dubbing ----------------
def decode(src, dst, tempo=1.0):
    a = ["-i", src, "-ac", "1", "-ar", str(RATE)]
    if tempo > 1.01:
        a += ["-filter:a", f"atempo={tempo:.3f}"]
    ff(*a, "-sample_fmt", "s16", dst)


def pcm(p):
    with wave.open(p, "rb") as w:
        return w.readframes(w.getnframes())


async def synth(items, d, stem):
    sem, n = asyncio.Semaphore(6), 0

    async def one(i, it):
        nonlocal n
        f = f"{d}/c{i:05d}.mp3"
        async with sem:
            for k in range(4):
                if os.path.exists(f) and os.path.getsize(f) > 0:
                    break
                try:
                    await edge_tts.Communicate(it["text"], it["voice"], rate=f"+{SPEECH_RATE}%").save(f)
                except Exception:
                    if os.path.exists(f):
                        os.remove(f)
                    await asyncio.sleep(1.5 * (k + 1))
        n += 1
        if n % 300 == 0:
            log(stem, f"voice {n}/{len(items)}")

    await asyncio.gather(*(one(i, it) for i, it in enumerate(items)))


def dub_movie(video, segs, km, genders, out_mp4, stem):
    items = []
    for i, (s, t) in enumerate(zip(segs, km)):
        t = re.sub(r"\s+", " ", t).strip()
        if not t or t == ".":
            continue
        g = genders[i] if genders and i < len(genders) and genders[i] else DEFAULT_VOICE
        items.append({"start": s["start"], "end": s["end"], "text": t, "voice": VOICES[g]})
    items.sort(key=lambda x: x["start"])
    if not items:
        raise ValueError("no Khmer text")
    d = f"{TMP}/dub"
    shutil.rmtree(d, ignore_errors=True)
    os.makedirs(d)
    run_async(synth(items, d, stem))

    tmp = f"{d}/t.wav"
    track = np.zeros(int((items[-1]["end"] + 15) * RATE), dtype=np.int32)
    for i, it in enumerate(items):
        mp3 = f"{d}/c{i:05d}.mp3"
        if not os.path.exists(mp3) or os.path.getsize(mp3) == 0:
            continue
        st = int(it["start"] * RATE)
        nxt = items[i + 1]["start"] if i + 1 < len(items) else it["end"] + 3
        slot = max(0.6, nxt - it["start"] + 0.3)
        decode(mp3, tmp)
        b = np.frombuffer(pcm(tmp), dtype=np.int16)
        dur = len(b) / RATE
        if dur > slot:
            decode(mp3, tmp, min(2.0, dur / slot))
            b = np.frombuffer(pcm(tmp), dtype=np.int16)
        if st + len(b) > len(track):
            track = np.pad(track, (0, st + len(b) - len(track)))
        track[st:st + len(b)] += b
        if i % 300 == 0:
            log(stem, f"build track {i}/{len(items)}")
    wav = f"{d}/dub.wav"
    with wave.open(wav, "wb") as o:
        o.setnchannels(1)
        o.setsampwidth(2)
        o.setframerate(RATE)
        o.writeframes(np.clip(track, -32768, 32767).astype(np.int16).tobytes())
    del track
    gc.collect()

    log(stem, "merging into video...")
    dv = KHMER_VOL * 0.67
    try:
        if ORIG_VOL <= 0:
            raise RuntimeError("no original audio")
        ff("-i", video, "-i", wav, "-filter_complex",
           f"[0:a]volume={ORIG_VOL * 2}[o];[1:a]volume={dv:.2f}[d];"
           f"[o][d]amix=inputs=2:duration=first:dropout_transition=0,alimiter=limit=0.95[a]",
           "-map", "0:v:0", "-map", "[a]", "-c:v", "copy", "-c:a", "aac", "-b:a", "192k", out_mp4)
    except Exception:
        ff("-i", video, "-i", wav, "-filter_complex", f"[1:a]volume={dv:.2f},alimiter=limit=0.95[a]",
           "-map", "0:v:0", "-map", "[a]", "-c:v", "copy", "-c:a", "aac", "-b:a", "192k",
           "-shortest", out_mp4)
    shutil.rmtree(d, ignore_errors=True)


# ---------------- one movie ----------------
def process(fname):
    stem = os.path.splitext(fname)[0]
    final = f"{OUT_DIR}/{stem}_km.mp4"
    src_srt, km_srt, g_json = (f"{OUT_DIR}/{stem}.src.srt", f"{OUT_DIR}/{stem}.km.srt",
                               f"{OUT_DIR}/{stem}.gender.json")
    local = f"{TMP}/{fname}"
    wav = f"{TMP}/{stem}.16k.wav"
    try:
        log(stem, "copy from Drive...")
        shutil.copy(f"{SRC_DIR}/{fname}", local)
        make_wav(local, wav)

        # 1. transcript (resume if saved)
        if os.path.exists(src_srt):
            segs, src_txt = srt_read(src_srt)
            log(stem, f"transcript loaded ({len(segs)} lines)")
        else:
            audio = load_wav(wav)
            segs_t = whisper_segments(audio, stem)
            del audio
            gc.collect()
            segs = [{"start": s["start"], "end": s["end"]} for s in segs_t]
            src_txt = [s["text"] for s in segs_t]
            srt_write(src_srt, segs, src_txt)
            log(stem, f"transcript saved ({len(segs)} lines)")

        # 2. translation
        if os.path.exists(km_srt):
            _, km = srt_read(km_srt)
            if len(km) != len(segs):
                km = None
        else:
            km = None
        if km is None:
            km = translate_all(src_txt, stem)
            srt_write(km_srt, segs, km)
            log(stem, "Khmer saved")

        # 3. gender
        genders = []
        if DETECT_GENDER:
            if os.path.exists(g_json):
                genders = json.load(open(g_json))
            else:
                audio = load_wav(wav)
                genders = detect_genders(audio, segs)
                del audio
                gc.collect()
                json.dump(genders, open(g_json, "w"))

        # 4. dubbing -> Drive
        out_local = f"{TMP}/{stem}_km.mp4"
        dub_movie(local, segs, km, genders, out_local, stem)
        shutil.copy(out_local, final + ".part")
        os.replace(final + ".part", final)
        log(stem, f"DONE -> {final}")
    finally:
        for p in (local, wav, f"{TMP}/{stem}_km.mp4"):
            if os.path.exists(p):
                os.remove(p)
        gc.collect()


# ---------------- main loop ----------------
files = sorted(f for f in os.listdir(SRC_DIR) if f.lower().endswith(('.mp4', '.mkv', '.webm', '.mov', '.avi')))
if ONLY:
    files = [f for f in files if f in ONLY]
print(f"{len(files)} movies found")
ok, failed, skipped = [], [], []
for n, f in enumerate(files, 1):
    stem = os.path.splitext(f)[0]
    if os.path.exists(f"{OUT_DIR}/{stem}_km.mp4"):
        skipped.append(f)
        print(f"({n}/{len(files)}) skip (already done): {f}")
        continue
    print(f"\n===== ({n}/{len(files)}) {f} =====")
    t0 = time.time()
    try:
        process(f)
        ok.append(f)
        print(f"finished in {(time.time() - t0) / 60:.1f} min")
    except Exception as e:
        failed.append(f)
        print(f"[{stem}] ERROR: {e}")
        traceback.print_exc()

print("\n========== SUMMARY ==========")
print("done   :", ok)
print("skipped:", skipped)
print("failed :", failed, "(run again to retry)")
